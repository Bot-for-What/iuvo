NODE_ENV=development
PORT=30040

DB_HOST=localhost
DB_PORT=30041
DB_NAME=service_request_app
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

PENDING_2FA_JWT_SECRET=replace-with-a-different-long-random-secret
PENDING_2FA_EXPIRES_IN=5m

TOTP_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
TOTP_ISSUER=IUVO

INTERNAL_CRON_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

BCRYPT_ROUNDS=12

SUPER_RECOVERY_KEY=replace-with-a-long-random-secret

# Optional; only if the application currently uses it.
# QR_MANUAL_KEY=replace-with-a-private-value