{
  "name": "service-request-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the multi-unit service request application",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-super": "node scripts/create-super.js",
    "recover-super": "node scripts/recover-super.js",
    "migrate:latest": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.js migrate:list",
    "db:check": "node src/db/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "knex": "^3.1.0"
  }
}
