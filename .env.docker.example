# PostgreSQL credentials for the Docker database.
DB_NAME=service_request_app
DB_USER=postgres
DB_PASSWORD=replace-with-a-long-unique-password

# Backend authentication and cryptographic secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

PENDING_2FA_JWT_SECRET=replace-with-a-different-long-random-secret
PENDING_2FA_EXPIRES_IN=5m

# Exactly 64 hexadecimal characters: 32 bytes for AES-256-GCM.
TOTP_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
TOTP_ISSUER=IUVO

INTERNAL_CRON_KEY=replace-with-a-long-random-secret
SUPER_RECOVERY_KEY=replace-with-a-long-random-secret

# Browser origin for the Docker frontend.
FRONTEND_ORIGIN=http://localhost:8080

BCRYPT_ROUNDS=12
